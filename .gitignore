# Build output. Each build folder is regenerated by CMake and the lesson runner.
build/
**/build/

# Runner state and browser data.
.lesson-runner/
*.WebView2/
lesson-runner/*.WebView2/
lesson-runner.exe.WebView2/
lesson-runner/build/webview2-profile/

# Downloaded and generated files under resources. setup.ps1 recreates them.
resources/vendor/webview2/sdk/
resources/vendor/cjson/cJSON.c
resources/vendor/cjson/cJSON.h
resources/vendor/cjson/LICENSE
resources/vendor/cjson/VERSION.txt
lesson-runner/host/app.ico

# Editor and IDE settings.
.vscode/
.idea/
*.user

# Windows and macOS housekeeping.
Thumbs.db
.DS_Store

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp
*.pdb

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json

# Debug files
*.dSYM/
*.su
*.idb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# test output & cache
Testing/
.cache/
